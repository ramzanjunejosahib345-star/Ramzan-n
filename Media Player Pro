local function say(t)
  t = tostring(t)
  pcall(function() service.speak(t) end)
  pcall(function() speak(t) end)
end
-- shows an error in a window where the text can be selected and copied
local function showErr(t)
  t = tostring(t)
  say("Plugin could not start. A window with the error is open.")
  pcall(function()
    local ctxx = activity or service
    local AD = luajava.bindClass("android.app.AlertDialog$Builder")
    local TV = luajava.bindClass("android.widget.TextView")
    local SV = luajava.bindClass("android.widget.ScrollView")
    local tv = luajava.newInstance("android.widget.TextView", ctxx)
    tv.setText(t)
    tv.setTextIsSelectable(true)
    tv.setPadding(30, 20, 30, 20)
    local sv = luajava.newInstance("android.widget.ScrollView", ctxx)
    sv.addView(tv)
    local b = luajava.newInstance("android.app.AlertDialog$Builder", ctxx)
    b.setTitle("Media Player Pro error")
    b.setView(sv)
    b.setPositiveButton("Copy the error", luajava.createProxy("android.content.DialogInterface$OnClickListener", {
      onClick = function(d, w)
        pcall(function()
          local cm = ctxx.getSystemService("clipboard")
          cm.setPrimaryClip(luajava.bindClass("android.content.ClipData").newPlainText("error", t))
        end)
        say("Error copied")
      end}))
    b.setNegativeButton("Close", nil)
    local d = b.create()
    if activity == nil then pcall(function() d.getWindow().setType(2032) end) end
    d.show()
  end)
end
local function cacheFile()
  local dir = nil
  pcall(function() dir = (service or activity).getFilesDir() end)
  if dir == nil then pcall(function() dir = (service or activity).getExternalFilesDir(nil) end) end
  if dir == nil then return nil end
  return tostring(dir.getAbsolutePath()) .. "/mpp_code.lua"
end
local function verParts(v)
  local t = {}
  for n in tostring(v or ""):gmatch("%d+") do t[#t + 1] = tonumber(n) end
  return t
end
local function isNewer(a, b)
  local x, y = verParts(a), verParts(b)
  for i = 1, math.max(#x, #y) do
    local p, q = x[i] or 0, y[i] or 0
    if p ~= q then return p > q end
  end
  return false
end
local function readAll(p)
  local ok, d = pcall(function()
    local f = io.open(p, "rb")
    if not f then return nil end
    local t = f:read("a")
    f:close()
    return t
  end)
  if ok then return d end
  return nil
end
local function inflateB64(b64)
  local data = luajava.bindClass("android.util.Base64").decode(b64, 0)
  local inf = Inflater()
  inf.setInput(data)
  local baos = ByteArrayOutputStream()
  local buf = Array.newInstance(Byte.TYPE, 65536)
  local guard = 0
  while not inf.finished() and guard < 4000 do
    local n = tonumber(inf.inflate(buf))
    if n > 0 then baos.write(buf, 0, n)
    elseif inf.needsInput() or inf.needsDictionary() then break end
    guard = guard + 1
  end
  pcall(function() inf["end"]() end)
  return tostring(baos.toString("UTF-8"))
end
local function embeddedCode()
  return inflateB64(table.concat(PAYLOAD))
end
-- Used by the updater: takes the text of a newer loader file and returns the plugin code inside it
function MPP_EXTRACT(text)
  local ok, res = pcall(function()
    local parts = {}
    for line in tostring(text):gmatch("[^\r\n]+") do
      local b = line:match('^"([A-Za-z0-9+/=]+)",?$')
      if b then parts[#parts + 1] = b end
    end
    if #parts == 0 then return nil end
    return inflateB64(table.concat(parts))
  end)
  if ok then return res end
  return nil
end
function MPP_START()
  -- 1) newer downloaded update from the app folder
  local cf = cacheFile()
  local cached = cf and readAll(cf)
  if cached and cached:find("KSR_PLUGIN_ID: media_player_pro", 1, true) then
    local cv = cached:match("KSR_VERSION:%s*([%d%.]+)")
    if cv and isNewer(cv, EMB_VER) then
      local fn = load(cached, "=mpp_update", "t", _ENV)
      if fn then
        local ok, err = pcall(fn)
        if ok then return end
        say("Updated version could not start, using built-in version.")
        pcall(function() os.remove(cf) end)
      end
    end
  end
  -- 2) built-in version
  local ok, err = xpcall(function()
    local fn, e = load(embeddedCode(), "=media_player_pro", "t", _ENV)
    if not fn then error("load failed: " .. tostring(e)) end
    fn()
  end, function(e) return tostring(e) .. "\n" .. tostring(debug.traceback()) end)
  if not ok then showErr(err) end
end
MPP_START()